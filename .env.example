# btab Storefront API. Copy this file to .env.local and fill in your key.
# Both values are read in the browser, so they carry the NEXT_PUBLIC_ prefix.
# A publishable key is made for page code; never put a store API key (btab_live_...) here.

# The API base. Keep this value.
NEXT_PUBLIC_BTAB_API_BASE=https://api.btab.app/api/storefront/v1

# Your publishable key: btab dashboard → Settings → Developers → Publishable keys.
# A test key (btab_pk_test_...) shows btab's demo store and makes test orders only.
NEXT_PUBLIC_BTAB_PUBLISHABLE_KEY=btab_pk_test_replace_me

# The address this site runs on. It must be one of the key's allowed sites.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHOP_NAME="Starter Shop"
